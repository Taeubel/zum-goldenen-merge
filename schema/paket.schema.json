{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paket (Grundspiel oder Erweiterung)",
  "type": "object",
  "required": ["id", "name", "version", "status", "beschreibung", "benoetigt", "mechaniken"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum": ["experimentell", "spieltest", "stabil"]},
    "beschreibung": {"type": "string", "maxLength": 300},
    "benoetigt": {"type": "array", "items": {"type": "string"}},
    "mechaniken": {"type": "array", "items": {"type": "string"}}
  }
}
